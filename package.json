{
  "name": "obelisk-sfu",
  "version": "0.1.0",
  "private": true,
  "description": "Obelisk SFU — Nostr-identified mediasoup selective forwarding service. See docs/sfu-system.md.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "obelisk-sfu": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts",
    "raise": "./scripts/sfu-raise.sh",
    "deploy": "./scripts/sfu-deploy.sh",
    "setup": "./scripts/setup.sh",
    "generate-keys": "node scripts/generate-keys.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/test-peers/*.test.mjs src/*.test.ts",
    "test-peer:sfu": "node scripts/test-peers/test-peer-ms.mjs",
    "test-peer:mesh": "node scripts/test-peers/test-peer-mesh.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "dotenv": "^17.4.2",
    "mediasoup": "^3.22.0",
    "nostr-tools": "^2.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "werift": "^0.24.1"
  }
}
